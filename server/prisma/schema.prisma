generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model applications {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startup_id   String              @db.Uuid
  developer_id String              @db.Uuid
  message      String?
  status       application_status? @default(pending)
  applied_at   DateTime?           @default(now()) @db.Timestamp(6)
  users        users               @relation(fields: [developer_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_developer")
  startups     startups            @relation(fields: [startup_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_application_startup")

  @@unique([startup_id, developer_id], map: "unique_application")
}

model notifications {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String            @db.Uuid
  title        String            @db.VarChar(150)
  message      String
  type         notification_type
  reference_id String?           @db.Uuid
  is_read      Boolean           @default(false)
  created_at   DateTime          @default(now()) @db.Timestamp(6)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_notification_user")
}

model profiles {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @unique @db.Uuid
  full_name     String    @db.VarChar(100)
  username      String    @unique @db.VarChar(50)
  bio           String?
  skills        String[]
  github_url    String?   @db.VarChar(255)
  linkedin_url  String?   @db.VarChar(255)
  profile_image String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  updated_at    DateTime? @default(now()) @db.Timestamp(6)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_profile_user")
}

model project_members {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  project_id String    @db.Uuid
  user_id    String    @db.Uuid
  joined_at  DateTime? @default(now()) @db.Timestamp(6)
  projects   projects  @relation(fields: [project_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_project")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_member_user")

  @@unique([project_id, user_id], map: "unique_project_member")
}

model projects {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startup_id      String            @unique @db.Uuid
  founder_id      String            @db.Uuid
  project_name    String            @db.VarChar(100)
  description     String?
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  project_members project_members[]
  users           users             @relation(fields: [founder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_founder")
  startups        startups          @relation(fields: [startup_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_project_startup")
}

model startups {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  founder_id     String          @db.Uuid
  title          String          @db.VarChar(100)
  tagline        String?         @db.VarChar(255)
  description    String
  tech_stack     String[]
  required_roles String[]
  status         startup_status? @default(open)
  created_at     DateTime?       @default(now()) @db.Timestamp(6)
  updated_at     DateTime?       @default(now()) @db.Timestamp(6)
  applications   applications[]
  projects       projects?
  users          users           @relation(fields: [founder_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_startups_founder")
  tasks          tasks[]
}

model tasks {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startup_id  String        @db.Uuid
  assigned_to String?       @db.Uuid
  title       String        @db.VarChar(255)
  description String?
  priority    task_priority @default(medium)
  status      task_status   @default(todo)
  deadline    DateTime?     @db.Date
  created_at  DateTime      @default(now()) @db.Timestamp(6)
  updated_at  DateTime      @default(now()) @db.Timestamp(6)
  users       users?        @relation(fields: [assigned_to], references: [id], onUpdate: NoAction)
  startups    startups      @relation(fields: [startup_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String            @unique @db.VarChar(255)
  password        String
  role            user_role
  is_verified     Boolean?          @default(false)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  updated_at      DateTime?         @default(now()) @db.Timestamp(6)
  applications    applications[]
  notifications   notifications[]
  profiles        profiles?
  project_members project_members[]
  projects        projects[]
  startups        startups[]
  tasks           tasks[]
}

enum application_status {
  pending
  accepted
  rejected
  removed
}

enum notification_type {
  application
  task
  project
  system
}

enum startup_status {
  open
  closed
}

enum task_priority {
  low
  medium
  high
}

enum task_status {
  todo
  in_progress
  done
}

enum user_role {
  founder
  developer
}
